# Production configuration. Copy to .env (git-ignored) and fill in real values.
# The default `dev` profile needs none of this: it runs on an embedded H2 database.

SPRING_PROFILES_ACTIVE=prod

# PostgreSQL. Host, port and name have defaults; user and password do not.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mesh_connect
DB_USER=mesh
DB_PASSWORD=

# Base64, at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480

# Only needed when the client is served from a different origin than the API.
# The packaged build serves both from one port, so this can stay unset.
FRONTEND_ORIGIN=http://localhost:5173
