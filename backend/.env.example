# Mesh AI backend — environment variables (placeholders only; copy to .env).

# Supabase project URL + service-role key. The service-role key bypasses RLS —
# server-side only, never ship it in a client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Groq API key (LLM calls: pitches, skill crafting, feed AI, portfolio judging).
GROQ_API_KEY=your_groq_api_key_here

# Shared secret gating the /internal/* endpoints (called by DB triggers via
# pg_net, not end users). Generate a long random string; unset = fail closed.
NOTIFY_SECRET=your_random_shared_secret_here

# Firebase service-account JSON (the whole file as one line) for FCM push (push.py).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key":"...","client_email":"..."}

# OPTIONAL — only for offline embedding generation (embed_skills.py) when
# fastembed can't install; the live server never needs it.
COHERE_API_KEY=your_cohere_api_key_here
