# PostgreSQL database used by MESH. The database must exist before starting the API.
MESH_DATABASE_URL=jdbc:postgresql://localhost:5432/mesh
MESH_DATABASE_USERNAME=mesh
MESH_DATABASE_PASSWORD=change-me

# Generate a random 32-byte value and Base64 encode it. Do not use this example in production.
MESH_JWT_SECRET=replace-with-a-base64-encoded-32-byte-secret

# Optional; defaults to 60 minutes.
MESH_JWT_TTL_MINUTES=60

# Comma-separated browser origins allowed to call this API. Never use *.
MESH_ALLOWED_ORIGINS=http://localhost:5173

# GitHub OAuth is optional. Public repositories only are fetched; tokens are never stored.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/github/callback
GITHUB_SUCCESS_REDIRECT_URI=http://localhost:5173/settings?github=connected
GITHUB_ERROR_REDIRECT_URI=http://localhost:5173/settings?github=error
GITHUB_MAX_REPOSITORIES=20

# Discord identity linking and private project-room bot. Tokens are server-only.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/api/v1/discord/callback
DISCORD_SUCCESS_REDIRECT_URI=http://localhost:5173/settings?discord=connected
DISCORD_ERROR_REDIRECT_URI=http://localhost:5173/settings?discord=error
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Optional category under which MESH creates text rooms.
DISCORD_CATEGORY_ID=
