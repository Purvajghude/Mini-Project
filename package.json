{
  "name": "mesh-web",
  "private": true,
  "version": "1.0.0",
  "description": "Mesh Connect web client. Built into the Spring Boot jar and served from the same origin as the API.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:typecheck": "tsc -p web",
    "web:sync": "node web/server/sync.mjs"
  },
  "dependencies": {
    "@tldraw/sync": "^5.6.0",
    "@tldraw/sync-core": "^5.6.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.43.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tldraw": "^5.6.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
